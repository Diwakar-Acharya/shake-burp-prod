# Shake&Burp Production Environment File
# IMPORTANT: DO NOT COMMIT THIS FILE TO GIT (.gitignore protects this file)

DEBUG=False
SECRET_KEY=change-this-to-a-secure-64-character-production-key
ALLOWED_HOSTS=16.16.126.175,localhost,127.0.0.1

# AWS RDS PostgreSQL Connection (Replace YourMasterPasswordHere)
DATABASE_URL=postgres://postgres:YourMasterPasswordHere@shakeandburp-db.cv2qgequuyz9.eu-north-1.rds.amazonaws.com:5432/postgres

# Redis Cache & Celery Broker
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# AWS S3 Integration (Put your NEW rotated AWS IAM Keys here)
USE_S3=True
AWS_ACCESS_KEY_ID=YOUR_NEW_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_NEW_AWS_SECRET_ACCESS_KEY
AWS_STORAGE_BUCKET_NAME=shakeandburp-media-prod
AWS_S3_REGION_NAME=eu-north-1

# CSRF Trusted Origins
CSRF_TRUSTED_ORIGINS=http://16.16.126.175
